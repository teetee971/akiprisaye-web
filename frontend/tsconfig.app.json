{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": [
      "node",
      "vite/client"
    ],
    "skipLibCheck": true,
    "noPropertyAccessFromIndexSignature": false,
    "exactOptionalPropertyTypes": false
  },
  "include": [
    "src/main.tsx",
    "src/App.tsx",
    "src/pages/**/*",
    "src/components/**/*",
    "src/hooks/**/*",
    "src/context/**/*"
  ],
  "exclude": [
    "src/test",
    "src/**/__tests__",
    "src/utils",
    "src/services",
    "src/portal",
    "src/providers",
    "src/types"
  ]
}
