{
  "hosting": {
    "public": "y",
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "https://homygo.eu",
        "type": 301,
        "regex": "^/.*",
        "function": "noop"
      }
    ]
  }
}