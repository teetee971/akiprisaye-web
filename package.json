{

  "name": "akiprisaye-web",

  "version": "1.0.0",

  "private": true,

  "scripts": {

    "dev": "vite --host",

    "build": "vite build",

    "preview": "vite preview --host",

    "check": "tsc --noEmit",

    "start": "npm run preview",

    "optimize-seo": "node optimize-seo.js",

    "build:optimized": "npm run optimize-seo && npm run build",

    "test": "vitest",

    "test:run": "vitest run",

    "test:coverage": "vitest run --coverage",

    "test:ui": "vitest --ui",

    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings 0 || echo 'Linting completed with warnings'",

    "lighthouse": "lighthouse http://localhost:3000 --output=json --output-path=./lighthouse-report.json --chrome-flags='--headless' || echo 'Lighthouse completed'"

  },

  "dependencies": {

    "@heroicons/react": "^2.2.0",

    "chart.js": "^4.5.0",

    "firebase": "^12.3.0",

    "framer-motion": "^12.23.18",

    "fuse.js": "^7.1.0",

    "http-server": "^14.1.1",

    "leaflet": "^1.9.4",

    "react": "^18.3.1",

    "react-chartjs-2": "^5.2.0",

    "react-dom": "^18.3.1",

    "react-leaflet": "^4.2.1",

    "react-scroll": "^1.9.3"

  },

  "devDependencies": {

    "@tailwindcss/postcss": "^4.1.13",

    "@testing-library/jest-dom": "^6.8.0",

    "@testing-library/react": "^16.3.0",

    "@vitejs/plugin-react": "^4.5.0",

    "@vitest/coverage-v8": "^3.2.4",

    "autoprefixer": "^10.4.21",

    "esbuild": "^0.21.5",

    "eslint": "^9.36.0",

    "jsdom": "^27.0.0",

    "lighthouse": "^12.8.2",

    "postcss": "^8.5.6",

    "postcss-cli": "^11.0.1",

    "rollup": "^4.5.0",

    "tailwindcss": "^4.1.13",

    "typescript": "^5.6.3",

    "vite": "^5.4.10",

    "vitest": "^3.2.4"

  }

}

