{
  "name": "akiprisaye-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite --host",
    "build": "vite build --outDir dist/client",
    "build:client": "vite build --outDir dist/client",
    "preview": "vite preview --host",
    "check": "tsc --noEmit",
    "start": "npm run preview",
    "optimize-seo": "node optimize-seo.js",
    "build:optimized": "npm run optimize-seo && npm run build",
    "test": "npm run test:api && npm run test:build",
    "test:api": "chmod +x test_api.sh && ./test_api.sh",
    "test:build": "chmod +x test_build.sh && ./test_build.sh",
    "test:prod": "chmod +x scripts/check_prod.sh && ./scripts/check_prod.sh"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.21.5",
    "rollup": "^4.50.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}